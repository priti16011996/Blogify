<!DOCTYPE html>
<html lang="en">

<head>

    <%- include('./partials/head') %>

    <title><%= blog.title %> — Blogify</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

    <style>

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --ink: #111010;
            --ink-muted: #6b6860;
            --ink-light: #b0aea9;
            --paper: #f7f5f0;
            --paper-warm: #efecea;
            --white: #ffffff;
            --accent: #c8502a;
            --accent-pale: #f5e8e3;
            --border: rgba(17,16,16,0.1);
            --font-display: 'Playfair Display', Georgia, serif;
            --font-body: 'DM Sans', sans-serif;
            --radius: 4px;
            --radius-lg: 10px;
            --transition: 0.22s cubic-bezier(0.4,0,0.2,1);
        }

        body {
            background: var(--paper);
            color: var(--ink);
            font-family: var(--font-body);
            font-weight: 400;
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Back link ── */
        .back-bar {
            max-width: 780px;
            margin: 0 auto;
            padding: 2rem 2rem 0;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 500;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--ink-muted);
            text-decoration: none;
            transition: color var(--transition);
        }

        .back-link:hover {
            color: var(--accent);
            text-decoration: none;
        }

        .back-link svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* ── Article wrapper ── */
        .article-wrap {
            max-width: 780px;
            margin: 0 auto;
            padding: 2.5rem 2rem 5rem;
        }

        /* ── Hero image ── */
        .hero-image-wrap {
            width: 100%;
            border-radius: var(--radius-lg);
            overflow: hidden;
            margin-bottom: 2.5rem;
            background: var(--paper-warm);
        }

        .hero-image-wrap img {
            width: 100%;
            height: 460px;
            object-fit: cover;
            display: block;
        }

        /* ── Article header ── */
        .article-header {
            margin-bottom: 2rem;
        }

        .article-category {
            display: inline-block;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--accent);
            background: var(--accent-pale);
            padding: 4px 10px;
            border-radius: 2px;
            margin-bottom: 1.25rem;
        }

        .article-title {
            font-family: var(--font-display);
            font-size: clamp(1.9rem, 4vw, 2.8rem);
            font-weight: 700;
            line-height: 1.15;
            letter-spacing: -0.02em;
            color: var(--ink);
            margin-bottom: 1.5rem;
        }

        /* ── Author row ── */
        .author-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-bottom: 1.75rem;
            border-bottom: 1px solid var(--border);
        }

        .author-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
            border: 2px solid var(--paper-warm);
        }

        .author-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .author-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--ink);
        }

        .author-sub {
            font-size: 12px;
            color: var(--ink-light);
            font-weight: 300;
        }

        /* ── Article body ── */
        .article-body {
            padding: 2rem 0;
            border-bottom: 1px solid var(--border);
            font-size: 17px;
            font-weight: 300;
            line-height: 1.85;
            color: #2e2d2b;
            white-space: pre-line;
        }

        .article-body p + p {
            margin-top: 1.2em;
        }

        /* ── Comment section ── */
        .comment-section {
            margin-top: 3rem;
        }

        .section-heading {
            font-family: var(--font-display);
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--ink);
            margin-bottom: 1.75rem;
            display: flex;
            align-items: baseline;
            gap: 8px;
        }

        .section-heading .count {
            font-family: var(--font-body);
            font-size: 13px;
            font-weight: 400;
            color: var(--ink-light);
        }

        /* ── Comment form ── */
        .comment-form-wrap {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 1.5rem;
            margin-bottom: 2.5rem;
        }

        .comment-form-wrap label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--ink-muted);
            margin-bottom: 10px;
        }

        .comment-form-wrap textarea {
            width: 100%;
            min-height: 100px;
            resize: vertical;
            padding: 12px 14px;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: var(--paper);
            font-family: var(--font-body);
            font-size: 14px;
            color: var(--ink);
            outline: none;
            transition: border-color var(--transition);
            line-height: 1.6;
        }

        .comment-form-wrap textarea:focus {
            border-color: var(--accent);
        }

        .comment-submit {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-top: 12px;
            padding: 10px 22px;
            background: var(--accent);
            color: #fff;
            font-family: var(--font-body);
            font-size: 13px;
            font-weight: 500;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            border: none;
            border-radius: var(--radius);
            cursor: pointer;
            transition: background var(--transition), transform var(--transition);
        }

        .comment-submit:hover {
            background: #a83e20;
            transform: translateY(-1px);
        }

        .comment-submit svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* ── Comment list ── */
        .comment-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .comment-item {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 1.25rem 1.4rem;
            transition: border-color var(--transition);
        }

        .comment-item:hover {
            border-color: rgba(17,16,16,0.2);
        }

        .comment-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        .comment-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
            border: 1.5px solid var(--paper-warm);
        }

        .comment-user {
            font-size: 13px;
            font-weight: 500;
            color: var(--ink);
        }

        .comment-body {
            font-size: 14px;
            font-weight: 300;
            color: var(--ink-muted);
            line-height: 1.65;
            padding-left: 44px;
        }

        /* ── Empty comments ── */
        .empty-comments {
            text-align: center;
            padding: 3rem 1rem;
            color: var(--ink-light);
        }

        .empty-comments p {
            font-family: var(--font-display);
            font-size: 1rem;
            font-style: italic;
        }
        .likedBtn {
            display: inline-block !important;
            border:none;
            height:"40px";
            }

        /* ── Responsive ── */
        @media (max-width: 600px) {
            .back-bar,
            .article-wrap {
                padding-left: 1rem;
                padding-right: 1rem;
            }
            .hero-image-wrap img {
                height: 240px;
            }
        }

    </style>

</head>

<body>

    <%- include('./partials/nav') %>

    <div class="back-bar">
        <a href="/" class="back-link">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            All stories
        </a>
    </div>

    <div class="article-wrap">

        <!-- Cover image -->
        <% if(blog.coveredImageUrl){ %>
            <div class="hero-image-wrap">
                <img src="<%= blog.coveredImageUrl %>" alt="<%= blog.title %>">
            </div>
        <% } %>

        <!-- Article header -->
        <header class="article-header">
            <span class="article-category">Blog</span>
            <h1 class="article-title"><%= blog.title %></h1>

            <div class="author-row">
                <img
                    src="<%= blog.createdBy?.profilePic || '/images/default-user.png' %>"
                    class="author-avatar"
                    alt="<%= blog.createdBy?.username || 'Author' %>"
                >
                <div class="author-info">
                    <span class="author-name"><%= blog.createdBy?.username || 'Unknown' %></span>
                </div>
            </div>
            <form action="/blog/<%= blog._id %>/like" method="POST">
            <button type="submit" class="likedBtn">
                <% if (hasLiked) { %>
                    <i class="fa fa-thumbs-up fa-lg" aria-hidden="true"></i>
                <% } else { %>
                    <i class="fa fa-thumbs-o-up fa-lg" aria-hidden="true"></i
                <% } %>
                <span><%= blog.likes.length %> Likes</span>
            </button>
        </form>
        </header>

        <!-- Article content -->
        <div class="article-body">
            <%= blog.content %>
        </div>
         
        <!-- Comments -->
        <section class="comment-section">

            <h2 class="section-heading">
                Comments
                <span class="count"><%= comments.length %> <%= comments.length === 1 ? 'reply' : 'replies' %></span>
            </h2>

            <!-- Add comment form -->
            <div class="comment-form-wrap">
                <form action="/blog/comment/<%= blog._id %>" method="POST">
                    <label for="comment">Leave a reply</label>
                    <textarea
                        name="content"
                        id="comment"
                        placeholder="Share your thoughts..."
                        required
                    ></textarea>
                    <button type="submit" class="comment-submit">
                        <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                        Post reply
                    </button>
                </form>
            </div>

            <!-- Comment list -->
            <% if(comments.length === 0){ %>
                <div class="empty-comments">
                    <p>No replies yet — start the conversation.</p>
                </div>
            <% } else { %>
                <div class="comment-list">
                    <% comments.forEach(comment => { %>
                        <div class="comment-item">
                            <div class="comment-header">
                                <img
                                    src="<%= comment.createdBy?.profilePic || '/images/default-user.png' %>"
                                    class="comment-avatar"
                                    alt="<%= comment.createdBy?.username || 'User' %>"
                                >
                                <span class="comment-user"><%= comment.createdBy?.username || 'Anonymous' %></span>
                            </div>
                            <p class="comment-body"><%= comment.content %></p>
                        </div>
                    <% }) %>
                </div>
            <% } %>

        </section>

    </div>

    <%- include('./partials/scripts') %>

</body>

</html>
