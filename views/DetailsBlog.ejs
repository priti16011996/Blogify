<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
    <title><%= blog.title %> — Blogify</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>

        /* ── Reset & Root ── */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --ink:          #18181b;
            --ink-mid:      #3f3f46;
            --ink-muted:    #71717a;
            --ink-light:    #a1a1aa;
            --paper:        #fafaf9;
            --paper-warm:   #f5f3ef;
            --paper-card:   #ffffff;
            --accent:       #b45309;
            --accent-hover: #92400e;
            --accent-pale:  #fef3c7;
            --accent-pale2: #fffbeb;
            --border:       rgba(24,24,27,0.09);
            --border-mid:   rgba(24,24,27,0.16);
            --shadow-sm:    0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
            --shadow-md:    0 4px 16px rgba(0,0,0,0.08), 0 1px 4px rgba(0,0,0,0.04);
            --shadow-lg:    0 12px 40px rgba(0,0,0,0.10), 0 4px 12px rgba(0,0,0,0.05);
            --font-display: 'Lora', Georgia, serif;
            --font-body:    'Plus Jakarta Sans', sans-serif;
            --font-mono:    'JetBrains Mono', monospace;
            --radius:       6px;
            --radius-lg:    14px;
            --radius-xl:    20px;
            --transition:   0.2s cubic-bezier(0.4, 0, 0.2, 1);
            --max-w:        740px;
        }

        /* ── Custom Scrollbar ── */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: var(--paper-warm);
        }
        ::-webkit-scrollbar-thumb {
            background: #d6d3d1;
            border-radius: 99px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--accent);
        }
        * {
            scrollbar-width: thin;
            scrollbar-color: #d6d3d1 var(--paper-warm);
        }

        /* ── Base ── */
        html { scroll-behavior: smooth; }

        body {
            background: var(--paper);
            color: var(--ink);
            font-family: var(--font-body);
            font-weight: 400;
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Reading Progress Bar ── */
        #reading-progress {
            position: fixed;
            top: 0;
            left: 0;
            height: 3px;
            width: 0%;
            background: linear-gradient(90deg, var(--accent), #d97706);
            z-index: 9999;
            transition: width 0.1s linear;
            border-radius: 0 2px 2px 0;
        }

        /* ── Back bar ── */
        .back-bar {
            max-width: var(--max-w);
            margin: 0 auto;
            padding: 2rem 2rem 0;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            color: var(--ink-muted);
            text-decoration: none;
            padding: 7px 14px;
            border-radius: 99px;
            border: 1px solid var(--border-mid);
            background: var(--paper-card);
            box-shadow: var(--shadow-sm);
            transition: all var(--transition);
        }

        .back-link:hover {
            color: var(--accent);
            border-color: var(--accent);
            transform: translateX(-2px);
            box-shadow: var(--shadow-md);
        }

        .back-link svg {
            width: 13px; height: 13px;
            stroke: currentColor; fill: none;
            stroke-width: 2.5;
            stroke-linecap: round; stroke-linejoin: round;
        }

        /* ── Article wrapper ── */
        .article-wrap {
            max-width: var(--max-w);
            margin: 0 auto;
            padding: 2.5rem 2rem 6rem;
        }

        /* ── Hero ── */
        .hero-wrap {
            position: relative;
            width: 100%;
            border-radius: var(--radius-xl);
            overflow: hidden;
            margin-bottom: 2.5rem;
            box-shadow: var(--shadow-lg);
        }

        .hero-wrap img {
            width: 100%;
            height: 480px;
            object-fit: cover;
            display: block;
            transition: transform 0.6s ease;
        }

        .hero-wrap:hover img { transform: scale(1.02); }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.35) 0%, transparent 55%);
        }

        /* ── Article header ── */
        .article-header {
            margin-bottom: 2.5rem;
        }

        .article-category {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--accent);
            background: var(--accent-pale);
            border: 1px solid rgba(180,83,9,0.18);
            padding: 5px 12px;
            border-radius: 99px;
            margin-bottom: 1.25rem;
        }

        .article-title {
            font-family: var(--font-display);
            font-size: clamp(1.85rem, 4.5vw, 2.75rem);
            font-weight: 700;
            line-height: 1.2;
            letter-spacing: -0.025em;
            color: var(--ink);
            margin-bottom: 2rem;
        }

        /* ── Author row ── */
        .author-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            padding: 1.25rem 1.5rem;
            background: var(--paper-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            margin-bottom: 1.5rem;
        }

        .author-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .author-avatar {
            width: 46px; height: 46px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--accent-pale);
            flex-shrink: 0;
        }

        .author-info { display: flex; flex-direction: column; gap: 2px; }

        .author-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--ink);
        }

        .author-sub {
            font-size: 12px;
            color: var(--ink-light);
        }

        /* ── Like button ── */
        .like-form { display: inline; }

        .like-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 20px;
            background: var(--paper-warm);
            border: 1px solid var(--border-mid);
            border-radius: 99px;
            font-family: var(--font-body);
            font-size: 13px;
            font-weight: 600;
            color: var(--ink-mid);
            cursor: pointer;
            transition: all var(--transition);
        }

        .like-btn:hover {
            background: var(--accent-pale);
            border-color: var(--accent);
            color: var(--accent);
            transform: scale(1.04);
        }

        .like-btn.liked {
            background: var(--accent-pale);
            border-color: var(--accent);
            color: var(--accent);
        }

        .like-btn i { font-size: 15px; }

        /* ── Divider ── */
        .article-divider {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin: 0 0 2.5rem;
            color: var(--ink-light);
            font-size: 11px;
            font-family: var(--font-mono);
            letter-spacing: 0.05em;
        }
        .article-divider::before, .article-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        /* ══════════════════════════════════════
           ARTICLE BODY — Rich Content Styling
        ══════════════════════════════════════ */
        .article-body {
            font-family: var(--font-display);
            font-size: 17.5px;
            font-weight: 400;
            line-height: 1.9;
            color: var(--ink-mid);
        }

        /* Paragraphs */
        .article-body p {
            margin-bottom: 1.6em;
        }

        /* Section numbers like "01", "02" … become styled headings */
        .article-body .section-num {
            display: inline-block;
            font-family: var(--font-mono);
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 0.12em;
            color: var(--accent);
            background: var(--accent-pale);
            border: 1px solid rgba(180,83,9,0.2);
            padding: 3px 9px;
            border-radius: 4px;
            margin-bottom: 6px;
        }

        .article-body h2 {
            font-family: var(--font-display);
            font-size: 1.55rem;
            font-weight: 700;
            color: var(--ink);
            margin: 2.5rem 0 0.8rem;
            letter-spacing: -0.02em;
            line-height: 1.3;
        }

        .article-body h3 {
            font-family: var(--font-body);
            font-size: 1rem;
            font-weight: 600;
            color: var(--ink);
            margin: 1.8rem 0 0.6rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        /* Blockquotes */
        .article-body blockquote {
            position: relative;
            margin: 2rem 0;
            padding: 1.5rem 1.75rem 1.5rem 2rem;
            background: var(--accent-pale2);
            border-left: 4px solid var(--accent);
            border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
            font-style: italic;
            font-size: 1.05em;
            color: var(--ink-mid);
        }

        .article-body blockquote::before {
            content: '\201C';
            position: absolute;
            top: -8px; left: 12px;
            font-size: 4rem;
            color: var(--accent);
            opacity: 0.25;
            font-family: Georgia, serif;
            line-height: 1;
        }

        /* Inline code */
        .article-body code {
            font-family: var(--font-mono);
            font-size: 0.82em;
            background: #f4f4f5;
            color: var(--accent);
            padding: 2px 7px;
            border-radius: 4px;
            border: 1px solid #e4e4e7;
        }

        /* Lists */
        .article-body ul, .article-body ol {
            margin: 1rem 0 1.5rem 1.25rem;
        }
        .article-body li {
            margin-bottom: 0.5rem;
        }

        /* Horizontal rule */
        .article-body hr {
            border: none;
            border-top: 1px solid var(--border);
            margin: 2.5rem 0;
        }

        /* Strong */
        .article-body strong {
            font-weight: 600;
            color: var(--ink);
        }

        /* Drop cap on first letter */
        .article-body > p:first-of-type::first-letter {
            font-family: var(--font-display);
            font-size: 3.8rem;
            font-weight: 700;
            float: left;
            line-height: 0.85;
            margin: 0.08em 0.12em 0 0;
            color: var(--accent);
        }

        /* ── Pull quote card ── */
        .pull-quote {
            background: var(--ink);
            color: var(--paper);
            border-radius: var(--radius-lg);
            padding: 2rem 2.25rem;
            margin: 2.5rem 0;
            position: relative;
            overflow: hidden;
        }

        .pull-quote::before {
            content: '';
            position: absolute;
            top: -30px; right: -30px;
            width: 120px; height: 120px;
            background: var(--accent);
            opacity: 0.12;
            border-radius: 50%;
        }

        .pull-quote p {
            font-family: var(--font-display);
            font-style: italic;
            font-size: 1.2rem;
            line-height: 1.65;
            color: #e5e7eb;
            margin: 0;
        }

        .pull-quote cite {
            display: block;
            margin-top: 1rem;
            font-family: var(--font-mono);
            font-size: 11px;
            color: #9ca3af;
            font-style: normal;
            letter-spacing: 0.05em;
        }

        /* ── Tags ── */
        .article-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 1px solid var(--border);
        }

        .tag {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            color: var(--ink-muted);
            background: var(--paper-warm);
            border: 1px solid var(--border-mid);
            padding: 5px 13px;
            border-radius: 99px;
            text-decoration: none;
            transition: all var(--transition);
        }

        .tag:hover {
            color: var(--accent);
            border-color: var(--accent);
            background: var(--accent-pale);
        }

        /* ── Comment section ── */
        .comment-section {
            margin-top: 4rem;
            padding-top: 3rem;
            border-top: 2px solid var(--border);
        }

        .section-heading {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--ink);
            margin-bottom: 2rem;
            display: flex;
            align-items: baseline;
            gap: 10px;
        }

        .section-heading .count {
            font-family: var(--font-mono);
            font-size: 12px;
            font-weight: 400;
            color: var(--ink-light);
            background: var(--paper-warm);
            border: 1px solid var(--border);
            padding: 2px 10px;
            border-radius: 99px;
        }

        /* ── Comment form ── */
        .comment-form-wrap {
            background: var(--paper-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-xl);
            padding: 1.75rem;
            margin-bottom: 2.5rem;
            box-shadow: var(--shadow-md);
            position: relative;
            overflow: hidden;
        }

        .comment-form-wrap::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--accent), #d97706, transparent);
        }

        .comment-form-label {
            display: block;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--ink-muted);
            margin-bottom: 10px;
        }

        .comment-form-wrap textarea {
            width: 100%;
            min-height: 110px;
            resize: vertical;
            padding: 13px 15px;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-lg);
            background: var(--paper);
            font-family: var(--font-body);
            font-size: 14px;
            line-height: 1.65;
            color: var(--ink);
            outline: none;
            transition: border-color var(--transition), box-shadow var(--transition);
        }

        .comment-form-wrap textarea:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(180,83,9,0.1);
        }

        .comment-submit {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 12px;
            padding: 11px 24px;
            background: var(--accent);
            color: #fff;
            font-family: var(--font-body);
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            border: none;
            border-radius: 99px;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(180,83,9,0.3);
            transition: all var(--transition);
        }

        .comment-submit:hover {
            background: var(--accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(180,83,9,0.4);
        }

        .comment-submit:active { transform: translateY(0); }

        .comment-submit svg {
            width: 13px; height: 13px;
            stroke: currentColor; fill: none;
            stroke-width: 2.5;
            stroke-linecap: round; stroke-linejoin: round;
        }

        /* ── Comment list ── */
        .comment-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .comment-item {
            background: var(--paper-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 1.4rem 1.5rem;
            box-shadow: var(--shadow-sm);
            transition: all var(--transition);
            position: relative;
        }

        .comment-item:hover {
            border-color: var(--border-mid);
            box-shadow: var(--shadow-md);
            transform: translateY(-1px);
        }

        .comment-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
        }

        .comment-avatar {
            width: 36px; height: 36px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
            border: 2px solid var(--paper-warm);
        }

        .comment-meta { display: flex; flex-direction: column; gap: 1px; }

        .comment-user {
            font-size: 13px;
            font-weight: 600;
            color: var(--ink);
        }

        .comment-date {
            font-size: 11px;
            font-family: var(--font-mono);
            color: var(--ink-light);
        }

        .comment-body {
            font-size: 14.5px;
            line-height: 1.7;
            color: var(--ink-muted);
            padding-left: 46px;
        }

        /* ── Empty state ── */
        .empty-comments {
            text-align: center;
            padding: 3rem 1rem;
            background: var(--paper-warm);
            border-radius: var(--radius-xl);
            border: 1px dashed var(--border-mid);
        }

        .empty-icon {
            font-size: 2.5rem;
            margin-bottom: 0.75rem;
            opacity: 0.4;
        }

        .empty-comments p {
            font-family: var(--font-display);
            font-size: 1rem;
            font-style: italic;
            color: var(--ink-light);
        }

        /* ── Floating TOC (optional enhancement) ── */
        .reading-meta {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            font-size: 12px;
            font-family: var(--font-mono);
            color: var(--ink-light);
            margin-bottom: 2.5rem;
            flex-wrap: wrap;
        }

        .reading-meta span {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        /* ── Responsive ── */
        @media (max-width: 640px) {
            .back-bar, .article-wrap { padding-left: 1.25rem; padding-right: 1.25rem; }
            .hero-wrap img { height: 240px; }
            .article-title { font-size: 1.7rem; }
            .article-body { font-size: 16px; }
            .author-row { flex-direction: column; align-items: flex-start; }
            .article-body > p:first-of-type::first-letter { font-size: 2.8rem; }
        }

    </style>
</head>

<body>

    <!-- Reading progress bar -->
    <div id="reading-progress"></div>

    <%- include('./partials/nav') %>

    <div class="back-bar">
        <a href="/" class="back-link">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            All stories
        </a>
    </div>

    <div class="article-wrap">

        <!-- Hero image -->
        <% if(blog.coveredImageUrl){ %>
            <div class="hero-wrap">
                <img src="<%= blog.coveredImageUrl %>" alt="<%= blog.title %>">
                <div class="hero-overlay"></div>
            </div>
        <% } %>

        <!-- Header -->
        <header class="article-header">
            <div class="article-category">
                <svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor"><circle cx="4" cy="4" r="4"/></svg>
                Blog
            </div>

            <h1 class="article-title"><%= blog.title %></h1>

            <!-- Reading meta -->
            <div class="reading-meta">
                <span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span id="read-time">—</span> min read
                </span>
                <span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    <%= new Date(blog.createdAt || Date.now()).toLocaleDateString('en-US', {year:'numeric', month:'long', day:'numeric'}) %>
                </span>
            </div>

            <!-- Author + like -->
            <div class="author-row">
                <div class="author-left">
                    <img
                        src="<%= blog.createdBy?.profilePic || '/images/default-user.png' %>"
                        class="author-avatar"
                        alt="<%= blog.createdBy?.username || 'Author' %>">
                    <div class="author-info">
                        <span class="author-name"><%= blog.createdBy?.username || 'Unknown' %></span>
                        <span class="author-sub">Author</span>
                    </div>
                </div>

                <form action="/blog/<%= blog._id %>/like" method="POST" class="like-form">
                    <button type="submit" class="like-btn <%= hasLiked ? 'liked' : '' %>">
                        <% if (hasLiked) { %>
                            <i class="fa fa-thumbs-up" aria-hidden="true"></i>
                        <% } else { %>
                            <i class="fa fa-thumbs-o-up" aria-hidden="true"></i>
                        <% } %>
                        <span><%= blog.likes.length %> Likes</span>
                    </button>
                </form>
            </div>
        </header>

        <div class="article-divider">· · ·</div>

        <!-- Article body -->
        <article class="article-body" id="article-body">
            <%- formatBlogContent(blog.content) %>
        </article>

        <!-- Tags -->
        <div class="article-tags">
            <a href="#" class="tag">MERN Stack</a>
            <a href="#" class="tag">Web Dev</a>
            <a href="#" class="tag">2026</a>
            <a href="#" class="tag">Roadmap</a>
        </div>

        <!-- Comments -->
        <section class="comment-section">
            <h2 class="section-heading">
                Comments
                <span class="count"><%= comments.length %> <%= comments.length === 1 ? 'reply' : 'replies' %></span>
            </h2>

            <!-- Form -->
            <div class="comment-form-wrap">
                <form action="/blog/comment/<%= blog._id %>" method="POST">
                    <label class="comment-form-label" for="comment">Leave a reply</label>
                    <textarea
                        name="content"
                        id="comment"
                        placeholder="Share your thoughts..."
                        required></textarea>
                    <button type="submit" class="comment-submit">
                        <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                        Post reply
                    </button>
                </form>
            </div>

            <!-- List -->
            <% if(comments.length === 0){ %>
                <div class="empty-comments">
                    <div class="empty-icon">💬</div>
                    <p>No replies yet — be the first to start the conversation.</p>
                </div>
            <% } else { %>
                <div class="comment-list">
                    <% comments.forEach(comment => { %>
                        <div class="comment-item">
                            <div class="comment-header">
                                <img
                                    src="<%= comment.createdBy?.profilePic || '/images/default-user.png' %>"
                                    class="comment-avatar"
                                    alt="<%= comment.createdBy?.username || 'User' %>">
                                <div class="comment-meta">
                                    <span class="comment-user"><%= comment.createdBy?.username || 'Anonymous' %></span>
                                    <span class="comment-date"><%= new Date(comment.createdAt || Date.now()).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></span>
                                </div>
                            </div>
                            <p class="comment-body"><%= comment.content %></p>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </section>

    </div>

    <%- include('./partials/scripts') %>

    <script>
        /* ── Reading progress bar ── */
        const bar = document.getElementById('reading-progress');
        window.addEventListener('scroll', () => {
            const doc   = document.documentElement;
            const total = doc.scrollHeight - doc.clientHeight;
            const pct   = total > 0 ? (window.scrollY / total) * 100 : 0;
            bar.style.width = pct + '%';
        });

        /* ── Estimated read time ── */
        (function () {
            const body  = document.getElementById('article-body');
            if (!body) return;
            const words = body.innerText.trim().split(/\s+/).length;
            const mins  = Math.max(1, Math.ceil(words / 200));
            document.getElementById('read-time').textContent = mins;
        })();
    </script>
</body>
</html>
