<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head') %>

  <title>Create Blog | Blogify</title>

  <style>

    body{
      background:#f5f7fb;
      min-height:100vh;
    }

    .create-blog-wrapper{
      padding:30px 0;
    }

    .blog-card{
      background:#fff;
      border:none;
      border-radius:24px;
      overflow:hidden;
      box-shadow:0 10px 40px rgba(0,0,0,0.08);
    }

    .blog-banner{
      background:linear-gradient(135deg,#1d2671,#c33764);
      padding:30px;
      color:white;
      position:relative;
      overflow:hidden;
    }

    .blog-banner::before{
      content:"";
      position:absolute;
      width:250px;
      height:250px;
      background:rgba(255,255,255,0.08);
      border-radius:50%;
      top:-80px;
      right:-80px;
    }

    .blog-banner h1{
      font-size:42px;
      font-weight:700;
      margin-bottom:12px;
    }

    .blog-banner p{
      color:rgba(255,255,255,0.8);
      max-width:500px;
      margin:0;
    }

    .form-section{
      padding:20px;
    }

    .form-label{
      font-weight:600;
      color:#333;
      margin-bottom:8px;
    }

    .form-control{
      border-radius:14px;
      border:1px solid #dcdcdc;
      box-shadow:none !important;
    }

    .form-control:focus{
      border-color:#6c63ff;
    }

    textarea.form-control{
      min-height:220px;
      resize:none;
    }

    .submit-btn{
      background:linear-gradient(135deg,#667eea,#764ba2);
      border:none;
      padding:14px;
      border-radius:14px;
      color:white;
      font-weight:600;
      transition:0.3s;
    }

    .submit-btn:hover{
      transform:translateY(-2px);
      opacity:0.95;
    }

    .preview-box{
      background:#f8f9fc;
      border:2px dashed #d7d7d7;
      border-radius:18px;
      padding:18px;
      text-align:center;
      margin-top:10px;
    }

    .preview-box img{
      width:100%;
      max-height:220px;
      object-fit:cover;
      border-radius:14px;
      display:none;
    }

    .small-text{
      font-size:14px;
      color:#777;
    }

  </style>
</head>

<body>

  <%- include('./partials/nav') %>

  <div class="container create-blog-wrapper">

    <div class="blog-card">

      <!-- Banner -->
      <div class="blog-banner">

        <h1>Create New Blog</h1>

        <p>
          Share your thoughts, ideas and stories with the world through Blogify.
        </p>

      </div>

      <!-- Form -->
      <div class="form-section">

        <form action="/blog/create" method="POST" enctype="multipart/form-data">

          <!-- Title -->
          <div class="mb-4">

            <label class="form-label">
              Blog Title
            </label>

            <input
              type="text"
              name="title"
              class="form-control"
              placeholder="Enter blog title..."
              required
            >

          </div>

          <!-- Image URL -->
          <div class="mb-4">

            <label class="form-label">
              Cover Image URL
            </label>

            <input
              type="file"
              name="coveredImageUrl"
              class="form-control"
              placeholder="Paste image URL..."
              id="coveredImageUrl"
            >

            <div class="preview-box">

              <img id="previewImage">

              <p class="small-text mt-2 mb-0">
                Image preview will appear here
              </p>

            </div>

          </div>

          <!-- Content -->
          <div class="mb-4">

            <label class="form-label">
              Blog Content
            </label>

            <textarea
              name="content"
              class="form-control"
              placeholder="Write your blog content here..."
              required
            ></textarea>

          </div>

          <!-- Button -->
          <div class="d-grid">

            <button class="submit-btn">

              Publish Blog 

            </button>

          </div>

        </form>

      </div>

    </div>

  </div>

  <%- include('./partials/scripts') %>

  <script>

    const coveredImageUrl = document.getElementById("coveredImageUrl");
    const previewImage = document.getElementById("previewImage");

    coveredImageUrl.addEventListener("input", () => {

      const url = coveredImageUrl.value.trim();

      if(url){
        previewImage.src = url;
        previewImage.style.display = "block";
      }else{
        previewImage.style.display = "none";
      }
    });

  </script>

</body>
</html>