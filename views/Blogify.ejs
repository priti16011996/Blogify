<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Blogify</title>

    <style>

        .blog-card {
            transition: 0.3s ease;
            height: 100%;
        }

        .blog-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        .blog-image {
            height: 220px;
            object-fit: cover;
        }

        .description {
            min-height: 80px;
        }

    </style>
</head>

<body>

    <%- include('./partials/nav') %>

    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>All Blogs</h1>

            <% if(user){ %>
                <a href="/blog/create" class="btn btn-primary">
                    Create Blog
                </a>
            <% } %>
        </div>

        <div class="row g-4">

            <% blogs.forEach((blog) => { %>

                <div class="col-lg-3 col-md-6 col-sm-12">

                    <div class="card blog-card">

                        <% if(blog.coveredImageUrl){ %>

                            <img
                                src="<%= blog.coveredImageUrl %>"
                                class="card-img-top blog-image"
                                alt="blog-image"
                            >

                        <% } %>

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title">
                                <%= blog.title %>
                            </h5>

                            <p class="text-muted mb-2">
                                By <%= blog.createdBy?.username || "Unknown" %>
                            </p>

                            <p
                                class="card-text description"
                                id="desc-<%= blog._id %>"
                            >
                                <% if(blog.content.length > 50){ %>

                                    <span class="short-text">
                                        <%= blog.content.slice(0, 50) %>...
                                    </span>

                                    <span
                                        class="full-text d-none"
                                    >
                                        <%= blog.content %>
                                    </span>

                                <% } else { %>

                                    <%= blog.content %>

                                <% } %>
                            </p>

                            <% if(blog.content.length > 50){ %>

                                <a
                                    href="/blog/<%= blog._id %>"
                                    class="btn btn-sm btn-primary mt-auto"
                                >
                                Read More
                                </a>

                            <% } %>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>

    <%- include('./partials/scripts') %>

    <script>

        function toggleText(id, btn){

            const container =
                document.getElementById(`desc-${id}`);

            const shortText =
                container.querySelector(".short-text");

            const fullText =
                container.querySelector(".full-text");

            if(fullText.classList.contains("d-none")){

                fullText.classList.remove("d-none");
                shortText.classList.add("d-none");

                btn.innerText = "Show Less";

            } else {

                fullText.classList.add("d-none");
                shortText.classList.remove("d-none");

                btn.innerText = "Show More";
            }
        }

    </script>

</body>
</html>