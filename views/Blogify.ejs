<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
        <title>Blogify</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link
            href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500&display=swap"
            rel="stylesheet">

        <style>
            *,
            *::before,
            *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --ink: #111010;
                --ink-muted: #6b6860;
                --ink-light: #b0aea9;
                --paper: #f7f5f0;
                --paper-warm: #efecea;
                --accent: #c8502a;
                --accent-pale: #f5e8e3;
                --border: rgba(17, 16, 16, 0.1);
                --font-display: 'Playfair Display', Georgia, serif;
                --font-body: 'DM Sans', sans-serif;
                --radius: 4px;
                --radius-lg: 10px;
                --transition: 0.22s cubic-bezier(0.4, 0, 0.2, 1);
            }

            body {
                background: var(--paper);
                color: var(--ink);
                font-family: var(--font-body);
                font-weight: 400;
                line-height: 1.6;
                -webkit-font-smoothing: antialiased;
            }

            /* ── Page wrapper ── */
            .page {
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 2rem 4rem;
            }

            /* ── Page header ── */
            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: flex-end;
                padding: 3rem 0 2rem;
                border-bottom: 1px solid var(--border);
                margin-bottom: 2.5rem;
            }

            .page-header-left h1 {
                font-family: var(--font-display);
                font-size: clamp(2rem, 4vw, 3rem);
                font-weight: 700;
                letter-spacing: -0.02em;
                line-height: 1.1;
                color: var(--ink);
            }

            .page-header-left p {
                font-size: 14px;
                color: var(--ink-muted);
                margin-top: 6px;
                font-weight: 300;
                letter-spacing: 0.04em;
                text-transform: uppercase;
            }

            /* ── Create button ── */
            .btn-create {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 10px 22px;
                background: var(--accent);
                color: #fff;
                font-family: var(--font-body);
                font-size: 13px;
                font-weight: 500;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                text-decoration: none;
                border-radius: var(--radius);
                border: none;
                cursor: pointer;
                transition: background var(--transition), transform var(--transition);
            }

            .btn-create:hover {
                background: #a83e20;
                transform: translateY(-1px);
                color: #fff;
                text-decoration: none;
            }

            .btn-create svg {
                width: 14px;
                height: 14px;
                stroke: currentColor;
                fill: none;
                stroke-width: 2.5;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

            /* ── Blog grid ── */
            .blog-grid {
                display: grid;
                grid-template-columns: repeat(12, 1fr);
                gap: 1.5rem;
            }

            /* Featured card — first blog spans more columns */
            .blog-card--featured {
                grid-column: span 7;
            }

            .blog-card--featured .card-image-wrap {
                height: 320px;
            }

            .blog-card--featured .card-title {
                font-size: clamp(1.2rem, 2vw, 1.6rem);
            }

            /* Regular cards */
            .blog-card--regular {
                grid-column: span 5;
            }

            .blog-card--regular .card-image-wrap {
                height: 220px;
            }

            /* After the first two, use 4-col cards */
            .blog-card--small {
                grid-column: span 4;
            }

            .blog-card--small .card-image-wrap {
                height: 180px;
            }

            /* Card base */
            .blog-card {
                background: #fff;
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                overflow: hidden;
                display: flex;
                flex-direction: column;
                transition: transform var(--transition), box-shadow var(--transition);
                cursor: pointer;
            }

            .blog-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 12px 40px rgba(17, 16, 16, 0.1);
            }

            /* Image area */
            .card-image-wrap {
                width: 100%;
                overflow: hidden;
                background: var(--paper-warm);
                position: relative;
                flex-shrink: 0;
            }

            .card-image-wrap img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .blog-card:hover .card-image-wrap img {
                transform: scale(1.04);
            }

            /* Placeholder when no image */
            .card-image-placeholder {
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                background: var(--paper-warm);
            }

            .card-image-placeholder span {
                font-family: var(--font-display);
                font-size: 3rem;
                color: var(--border);
                user-select: none;
            }

            /* Card body */
            .card-body {
                padding: 1.25rem 1.4rem 1.4rem;
                display: flex;
                flex-direction: column;
                flex: 1;
            }

            .card-meta {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 10px;
            }

            .card-category {
                font-size: 10px;
                font-weight: 500;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: var(--accent);
                background: var(--accent-pale);
                padding: 3px 9px;
                border-radius: 2px;
            }

            .card-date {
                font-size: 12px;
                color: var(--ink-light);
                font-weight: 300;
            }

            .card-title {
                font-family: var(--font-display);
                font-size: 1.15rem;
                font-weight: 600;
                line-height: 1.35;
                color: var(--ink);
                margin-bottom: 10px;
                text-decoration: none;
                display: block;
                transition: color var(--transition);
            }

            .blog-card:hover .card-title {
                color: var(--accent);
            }

            .card-excerpt {
                font-size: 13.5px;
                color: var(--ink-muted);
                line-height: 1.65;
                font-weight: 300;
                flex: 1;
                margin-bottom: 1rem;
                display: -webkit-box;
                -webkit-line-clamp: 3;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .card-footer {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding-top: 1rem;
                border-top: 1px solid var(--border);
                margin-top: auto;
            }

            .card-author {
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .author-avatar {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background: var(--accent-pale);
                color: var(--accent);
                font-size: 11px;
                font-weight: 500;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                text-transform: uppercase;
            }

            .author-name {
                font-size: 12px;
                color: var(--ink-muted);
                font-weight: 400;
            }

            .card-read-link {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                font-size: 12px;
                font-weight: 500;
                letter-spacing: 0.04em;
                color: var(--accent);
                text-decoration: none;
                text-transform: uppercase;
                transition: gap var(--transition);
            }

            .card-read-link:hover {
                gap: 8px;
                color: var(--accent);
                text-decoration: none;
            }

            .card-read-link svg {
                width: 13px;
                height: 13px;
                stroke: currentColor;
                fill: none;
                stroke-width: 2.5;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

            /* ── Empty state ── */
            .empty-state {
                grid-column: 1 / -1;
                text-align: center;
                padding: 5rem 2rem;
                color: var(--ink-muted);
            }

            .empty-state h3 {
                font-family: var(--font-display);
                font-size: 1.4rem;
                margin-bottom: 0.5rem;
                color: var(--ink);
            }

            .card-image-wrap {
                aspect-ratio: 16/9;
                overflow: hidden;
            }

            .card-image-wrap img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .card-actions {
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .edit-btn {
                text-decoration: none;
                padding: 6px 12px;
                border-radius: 8px;
                background: #eef2ff;
                color: #4f46e5;
                font-size: 12px;
                font-weight: 600;
            }

            .edit-btn:hover {
                background: #4f46e5;
                color: white;
            }

            .delete-btn {
                border: none;
                cursor: pointer;
                padding: 6px 12px;
                border-radius: 8px;
                background: #fee2e2;
                color: #dc2626;
                font-size: 12px;
                font-weight: 600;
            }

            .delete-btn:hover {
                background: #dc2626;
                color: white;
            }

            .delete-form {
                margin: 0;
            }

            .action-btn {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                padding: 6px 14px;
                font-family: var(--font-body);
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.07em;
                text-transform: uppercase;
                text-decoration: none;
                border-radius: 99px;
                border: 1.5px solid transparent;
                cursor: pointer;
                transition: all var(--transition);
                white-space: nowrap;
            }

            /* Read — ghost style */
            .action-btn--read {
                color: var(--ink-muted);
                border-color: var(--border);
                background: transparent;
            }

            .action-btn--read:hover {
                color: var(--accent);
                border-color: var(--accent);
                background: var(--accent-pale);
                text-decoration: none;
            }

            /* Edit — neutral */
            .action-btn--edit {
                color: var(--ink-muted);
                border-color: var(--border);
                background: transparent;
            }

            .action-btn--edit:hover {
                color: #4f46e5;
                border-color: #4f46e5;
                background: #eef2ff;
                text-decoration: none;
            }

            /* Delete — danger */
            .action-btn--delete {
                color: var(--ink-muted);
                border-color: var(--border);
                background: transparent;
            }

            .action-btn--delete:hover {
                color: #dc2626;
                border-color: #dc2626;
                background: #fee2e2;
            }

            .delete-form {
                margin: 0;
            }

            /* ── Responsive ── */
            @media (max-width: 960px) {

                .blog-card--featured,
                .blog-card--regular {
                    grid-column: span 12;
                }

                .blog-card--small {
                    grid-column: span 6;
                }
            }

            @media (max-width: 600px) {
                .page {
                    padding: 0 1rem 3rem;
                }

                .page-header {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 1rem;
                }

                .blog-card--featured,
                .blog-card--regular,
                .blog-card--small {
                    grid-column: span 12;
                }

                .blog-grid {
                    gap: 1rem;
                }
            }
        </style>
</head>

<body>

    <%- include('./partials/nav') %>

        <div class="page">

            <div class="page-header">
                <div class="page-header-left">
                    <h1>All Stories</h1>
                    <p>Ideas worth reading</p>
                </div>

                <!-- <% if(typeof user !== 'undefined' && user){ %>
                
            <% } %> -->
                <a href="/blog/create" class="btn-create">
                    <svg viewBox="0 0 24 24">
                        <line x1="12" y1="5" x2="12" y2="19" />
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                    Write a story
                </a>
            </div>

            <div class="blog-grid">

                <% if (typeof blogs !=='undefined' && blogs.length) { %>

                    <% blogs.forEach((blog, index)=> {

                        let cardClass = 'blog-card--small';
                        if (index === 0) cardClass = 'blog-card--featured';
                        else if (index === 1) cardClass = 'blog-card--regular';

                        const initials = (blog.createdBy?.username || 'U')
                        .split(' ')
                        .map(w => w[0])
                        .join('')
                        .slice(0, 2)
                        .toUpperCase();
                        %>

                        <article class="blog-card <%= cardClass %>">

                            <div class="card-image-wrap">
                                <% if(blog.coveredImageUrl){ %>
                                    <img src="<%= blog.coveredImageUrl %>" alt="<%= blog.title %>">
                                    <% } else { %>
                                        <div class="card-image-placeholder">
                                            <span>✦</span>
                                        </div>
                                        <% } %>
                            </div>

                            <div class="card-body">

                                <div class="card-meta">
                                    <span class="card-category">Blog</span>
                                </div>

                                <a href="/blog/<%= blog._id %>" class="card-title">
                                    <%= blog.title %>
                                </a>

                                <p class="card-excerpt">
                                    <%= blog.content %>
                                </p>

                                <div class="card-footer">
                                    <div class="card-author">
                                        <div class="author-avatar">
                                            <%= initials %>
                                        </div>
                                        <span class="author-name">
                                            <%= blog.createdBy?.username || 'Unknown' %>
                                        </span>
                                    </div>

                                    <div class="card-actions">

                                        <a href="/blog/<%= blog._id %>" class="action-btn action-btn--read">
                                            Read →
                                        </a>

                                        <% if ( user && ( user.role==="Admin" || ( user.id && blog.createdBy &&
                                            blog.createdBy._id && blog.createdBy._id.toString()===user.id.toString() ) )
                                            ) { %>

                                            <a href="/blog/edit/<%= blog._id %>" class="action-btn action-btn--edit">
                                                Edit
                                            </a>

                                            <form action="/blog/delete/<%= blog._id %>" method="POST"
                                                class="delete-form"
                                                onsubmit="return confirm('Are you sure you want to delete this blog?')">
                                                <button type="submit" class="action-btn action-btn--delete">
                                                    Delete
                                                </button>
                                            </form>

                                            <% } %>

                                    </div>
                                </div>
                            </div>

                        </article>

                        <% }) %>

                            <% } else { %>

                                <div class="empty-state">
                                    <h3>No stories yet</h3>
                                    <p>Be the first to share something worth reading.</p>
                                </div>

                                <% } %>

            </div>

        </div>

        <%- include('./partials/scripts') %>

</body>
</html>